<div class="ca-manager">
  <div class="ca-toolbar">
    <button class="ca-add-node" type="button" title="Add Scene Node">+</button>
    <button class="ca-import-folder ca-toolbar-pill" type="button" title="Import nodes from folder">Import</button>
    <button class="ca-sync-scenes{{#if nodesWithoutScene}} ca-sync-scenes--alert{{/if}}" type="button"
            title="{{#if hasAnyScene}}Sync all node scenes with current data{{else}}Create one Foundry Scene per node{{/if}}">
      {{#if hasAnyScene}}Update Scenes{{else}}Create Scenes{{/if}}{{#if nodesWithoutScene}} ({{nodesWithoutScene}}){{/if}}
    </button>

    {{!-- Separator before Free Move --}}
    <span class="ca-toolbar-sep"></span>

    {{!-- Navigation mode — single toggle pill (mirrors Autolock style) --}}
    <button class="ca-free-move-toggle ca-toolbar-pill {{#if (eq navigationMode 'open')}}ca-free-move-toggle--on{{else}}ca-free-move-toggle--off{{/if}}"
            type="button"
            title="Toggle Free Move — when ON players navigate freely; when OFF all moves require GM approval">
      Free Move: {{#if (eq navigationMode 'open')}}ON{{else}}OFF{{/if}}
    </button>

    {{!-- Requests button — shows count badge when queue is non-empty --}}
    <button class="ca-requests-btn ca-toolbar-pill {{#if requestCount}}ca-requests-btn--active{{/if}}"
            type="button" title="Pending navigation requests">
      {{#if requestCount}}Requests ({{requestCount}}){{else}}Requests{{/if}}
    </button>

    {{!-- Separator between Requests and Autolock --}}
    <span class="ca-toolbar-sep"></span>

    {{!-- Autolock global toggle --}}
    <button class="ca-autolock-toggle ca-toolbar-pill {{#if autolockDefault}}ca-autolock-toggle--on{{/if}}"
            type="button"
            title="When ON, all nodes set to Inherit will lock players upon arrival">
      Autolock: {{#if autolockDefault}}ON{{else}}OFF{{/if}}
    </button>

    {{!-- Visual Polls integration — only shown when the visual-polls module is active --}}
    {{#if visualPollsActive}}
    <span class="ca-toolbar-sep"></span>
    <button class="ca-poll-btn ca-toolbar-pill" type="button"
            title="Launch a navigation poll for all online players based on the GM's current node">
      <i class="fa-solid fa-square-poll-horizontal" aria-hidden="true"></i> Poll
    </button>
    {{/if}}

    {{!-- Spacer pushes Reset and Instructions to the far right --}}
    <span class="ca-toolbar-spacer"></span>

    <div class="ca-reset-menu-wrapper">
      <button class="ca-reset-menu-toggle ca-toolbar-pill" type="button" title="Reset options">
        Reset <i class="fa-solid fa-caret-down" aria-hidden="true"></i>
      </button>
      <div class="ca-reset-menu ca-context-menu" hidden>
        <div class="ca-context-menu-item ca-reset-macros{{#unless resetMacrosCount}} ca-context-menu-item--active{{/unless}}"
             title="Reset all once-executed macros across all nodes">
          Reset Macros ({{resetMacrosCount}})
        </div>
        <div class="ca-context-menu-divider"></div>
        <div class="ca-context-menu-item ca-reset-visited-scenes"
             title="Clear every player's visited-scene history (used by &quot;scene visited&quot; key conditions)">
          Reset Visited Scenes
        </div>
      </div>
    </div>
    <span class="ca-toolbar-sep"></span>
    <button class="ca-settings-btn" type="button" aria-label="Settings" title="Settings">
      <i class="fa-solid fa-gear" aria-hidden="true"></i>
    </button>
    <button class="ca-instructions-btn" type="button">Instructions</button>
  </div>

  {{!-- Navigation requests drawer --}}
  <div class="ca-requests-drawer {{#if drawerOpen}}ca-requests-drawer--open{{/if}}">
    <div class="ca-requests-drawer-header">Pending Navigation Requests</div>
    {{#if requests.length}}
    <button class="ca-approve-all-btn" type="button">
      Approve All ({{requestCount}})
    </button>
    {{/if}}
    {{#if requests.length}}
    <ul class="ca-requests-list">
      {{#each requests}}
      <li class="ca-request-item" data-user-id="{{userId}}">
        <span class="ca-request-dot" style="background: {{userColor}};"></span>
        <span class="ca-request-info">
          <strong>{{userName}}</strong>
          <span class="ca-request-route">{{fromLabel}} → {{toLabel}}</span>
        </span>
        <button class="ca-request-approve" data-user-id="{{userId}}" data-node-id="{{toNodeId}}" type="button" title="Approve">✓</button>
        <button class="ca-request-reject"  data-user-id="{{userId}}" type="button" title="Reject">✗</button>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="ca-requests-empty">No pending requests.</div>
    {{/if}}
  </div>

  <div class="ca-manager-layout">

    {{!-- LEFT SIDEBAR: Player panel --}}
    <aside class="ca-player-panel">
      <div class="ca-player-panel-title">
        <span class="ca-player-panel-title-text">Players</span>
        <button class="ca-bulk-lock-btn" data-action="lock-all"
                type="button" title="Lock All Players">
          <i class="fa-solid fa-lock"></i>
        </button>
        <button class="ca-bulk-lock-btn" data-action="unlock-all"
                type="button" title="Unlock All Players">
          <i class="fa-solid fa-lock-open"></i>
        </button>
      </div>

      <section class="ca-player-group ca-player-group--gm">
        <div class="ca-player-group-label">Game Master</div>
        <ul class="ca-player-list">
          {{#each players.gm}}
          <li class="ca-player-row {{#unless active}}ca-player-row--offline{{/unless}}"
              data-user-id="{{userId}}"
              {{#if nodeId}}data-node-id="{{nodeId}}"{{/if}}>
            <span class="ca-player-dot" style="background:{{color}};"
                  title="{{#if active}}Online{{else}}Offline{{/if}}"></span>
            <span class="ca-player-name">{{displayName}}</span>
          </li>
          {{/each}}
        </ul>
      </section>

      <section class="ca-player-group ca-player-group--online">
        <div class="ca-player-group-label">Online</div>
        <ul class="ca-player-list">
          {{#each players.online}}
          <li class="ca-player-row"
              data-user-id="{{userId}}"
              {{#if nodeId}}data-node-id="{{nodeId}}"{{/if}}>
            <span class="ca-player-dot" style="background:{{color}};" title="Online"></span>
            <span class="ca-player-name">{{displayName}}</span>
          </li>
          {{else}}
          <li class="ca-player-row ca-player-row--empty">No players online</li>
          {{/each}}
        </ul>
      </section>

      <section class="ca-player-group ca-player-group--offline">
        <div class="ca-player-group-label">Offline</div>
        <ul class="ca-player-list">
          {{#each players.offline}}
          <li class="ca-player-row ca-player-row--offline"
              data-user-id="{{userId}}"
              {{#if nodeId}}data-node-id="{{nodeId}}"{{/if}}>
            <span class="ca-player-dot" style="background:{{color}};" title="Offline"></span>
            <span class="ca-player-name">{{displayName}}</span>
          </li>
          {{else}}
          <li class="ca-player-row ca-player-row--empty">No players offline</li>
          {{/each}}
        </ul>
      </section>
    </aside>

    {{!-- WORKSPACE --}}
    <div class="ca-workspace">
    <div class="ca-zoom-controls">
      <button type="button" class="ca-zoom-reset" title="Reset zoom (100%)">100%</button>
      <button type="button" class="ca-zoom-all" title="Zoom to fit all nodes">Zoom All</button>
    </div>
    <div class="ca-canvas">
    <svg class="ca-links-layer" xmlns="http://www.w3.org/2000/svg" width="8000" height="8000"></svg>
    {{#each nodes}}
    <div class="ca-node" data-node-id="{{id}}" style="left: {{x}}px; top: {{y}}px;"
         {{#if (eq id ../startNodeId)}}data-start="true"{{/if}}
         {{#if (eq id ../activeNodeId)}}data-active="true"{{/if}}
         {{#if noExit}}data-no-exit="true" title="No way out for players — every passage from here is Blocked or Secret"{{/if}}>

      {{!-- Image — flush no topo, border-radius superior via CSS --}}
      {{#if imageSrc}}
        {{#if isVideo}}
        <div class="ca-node-image ca-node-image--video">
          <video src="{{imageSrc}}" muted loop autoplay playsinline></video>
        </div>
        {{else}}
        <div class="ca-node-image" style="background-image: url('{{imageSrc}}');"></div>
        {{/if}}
      {{else}}
      <div class="ca-node-image ca-node-image--empty"></div>
      {{/if}}

      {{!-- Label — área centralizada no rodapé --}}
      <div class="ca-node-label-area">
        <span class="ca-node-label">{{label}}</span>
      </div>

      {{!-- Button cluster — botões empilhados no canto superior direito --}}
      <div class="ca-node-buttons">
        <button class="ca-view-scene-btn" data-node-id="{{id}}" data-scene-id="{{sceneId}}"
                type="button" title="View Scene"
                {{#unless sceneId}}disabled{{/unless}}>
          <i class="fa-solid fa-eye" aria-hidden="true"></i>
        </button>
        <button class="ca-activate-scene-btn" data-node-id="{{id}}" data-scene-id="{{sceneId}}"
                type="button" title="Activate Scene"
                {{#unless sceneId}}disabled{{/unless}}>
          <i class="fa-solid fa-play" aria-hidden="true"></i>
        </button>
      </div>

      {{!-- Top-left cluster: start star + occupant badge --}}
      <div class="ca-node-top-left">
        {{#if (eq id ../startNodeId)}}
        <span class="ca-start-icon" title="Start point">
          <i class="fa-solid fa-star" aria-hidden="true"></i>
        </span>
        {{/if}}

        {{#if isCameraRoom}}
        <span class="ca-camera-icon" title="Camera Room">
          <i class="fa-solid fa-camera" aria-hidden="true"></i>
        </span>
        {{/if}}

        {{#if occupants.length}}
        <div class="ca-node-occupant-badge">
          <i class="fa-solid fa-people-group"></i>
          <span>{{occupants.length}}</span>
        </div>
        {{/if}}
      </div>

      <div class="ca-anchor ca-anchor-top"    data-anchor="top"></div>
      <div class="ca-anchor ca-anchor-right"  data-anchor="right"></div>
      <div class="ca-anchor ca-anchor-bottom" data-anchor="bottom"></div>
      <div class="ca-anchor ca-anchor-left"   data-anchor="left"></div>

      {{!-- Peek anchors at corners — visible when any node in the graph has camera room enabled --}}
      {{#if ../hasPeekAnchors}}
      <div class="ca-anchor ca-anchor-peek ca-anchor-peek-tl" data-anchor="peek-tl" data-type="peek"></div>
      <div class="ca-anchor ca-anchor-peek ca-anchor-peek-tr" data-anchor="peek-tr" data-type="peek"></div>
      <div class="ca-anchor ca-anchor-peek ca-anchor-peek-bl" data-anchor="peek-bl" data-type="peek"></div>
      <div class="ca-anchor ca-anchor-peek ca-anchor-peek-br" data-anchor="peek-br" data-type="peek"></div>
      {{/if}}
    </div>
    {{/each}}
    </div>
  </div>{{!-- /.ca-workspace --}}
  </div>{{!-- /.ca-manager-layout --}}
</div>{{!-- /.ca-manager --}}
