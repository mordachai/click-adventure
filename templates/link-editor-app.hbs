<div class="ca-link-editor">
  <div class="ca-link-editor-header">
    <div class="ca-link-nodes-display">
      <span class="ca-node-badge ca-node-badge--source" title="{{fromLabel}}">{{fromLabel}}</span>
      <span class="ca-node-arrow">↔</span>
      <span class="ca-node-badge ca-node-badge--target" title="{{toLabel}}">{{toLabel}}</span>
    </div>
  </div>
  <ul class="ca-passages-list">
    {{#each passages}}
    <li class="ca-card ca-passage-row" data-index="{{index}}">
      <input class="ca-input ca-passage-label" type="text" value="{{label}}" placeholder="Passage name (optional)" maxlength="100" />
      <button class="ca-btn ca-btn--quiet ca-btn--sm ca-display-mode-toggle" type="button"
              title="{{#if displayModeIsPathOnly}}Players see: Path Name only{{else}}Players see: Full Name (Path Name){{/if}}">
        {{#if displayModeIsPathOnly}}P{{else}}F{{/if}}
      </button>
      <button class="ca-btn ca-btn--quiet ca-btn--sm ca-passage-direction" type="button" title="Click to cycle direction: Both way / Forward / Backward"
              data-dir-axis="{{dirAxis}}">{{caDirectionAxisIcon dirAxis}}</button>
      <button class="ca-btn ca-btn--quiet ca-btn--sm ca-passage-state" type="button" title="Click to cycle state: Open / Blocked (secret) / Locked"
              data-state-axis="{{stateAxis}}">{{caStateAxisIcon stateAxis}}</button>
      <button class="ca-btn ca-btn--ghost-danger ca-btn--sm ca-passage-remove" type="button" title="Remove passage">✕</button>
    </li>
    {{/each}}
  </ul>
  <div class="ca-win-footer ca-link-editor-footer">
    <div class="ca-link-editor-footer-left">
      <button class="ca-btn ca-btn--blue ca-passage-add" type="button">
        <i class="fa-solid fa-plus" aria-hidden="true"></i> Add passage
      </button>
      {{#if isMulti}}
      <button class="ca-btn ca-btn--quiet ca-convert-to-single" type="button" title="Remove all passages except the first and revert to single-passage mode">Convert to single</button>
      {{/if}}
    </div>
    <button class="ca-btn ca-btn--accent ca-link-editor-save" type="button">Save</button>
  </div>
</div>
