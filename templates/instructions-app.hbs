    <button class="ca-tab ca-instr-tab-btn {{#if (eq activeTab 'links')}}ca-tab--active{{/if}}"
            data-tab="links" role="tab" aria-selected="{{eq activeTab 'links'}}">Links</button>
    <button class="ca-tab ca-instr-tab-btn {{#if (eq activeTab 'camera')}}ca-tab--active{{/if}}"
            data-tab="camera" role="tab" aria-selected="{{eq activeTab 'camera'}}">Camera Room</button>
    <button class="ca-tab ca-instr-tab-btn {{#if (eq activeTab 'players')}}ca-tab--active{{/if}}"
