<div class="ca-hud-root">
  {{#if isGM}}
  {{#if onlinePlayersInScene.length}}
  <div class="ca-hud-players">
    {{#each onlinePlayersInScene}}
    <div class="ca-hud-player-badge" style="--ca-player-color: {{color}};" title="{{name}}">
      <span class="ca-hud-player-dot"></span>
      <span class="ca-hud-player-name">{{name}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{else}}
  {{#if onlineAllPlayers.length}}
  <div class="ca-hud-players">
    {{#each onlineAllPlayers}}
    <div class="ca-hud-player-badge" style="--ca-player-color: {{color}};" title="{{name}}">
      <span class="ca-hud-player-dot"></span>
      <span class="ca-hud-player-name">{{name}}</span>
      {{#if previewSrc}}
      <span class="ca-hud-preview-eye" data-preview-src="{{previewSrc}}" data-is-video="{{isVideo}}">
        <i class="fa-solid fa-eye"></i>
      </span>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{/if}}

  {{#if hasAnyDirection}}
  <div class="ca-hud-destinations {{#if isOpen}}ca-hud-destinations--open{{/if}}">
    {{#each availableDestinations}}
    <button class="ca-hud-dest-btn {{#if secret}}ca-hud-dest-btn--secret{{/if}} {{#if blocked}}ca-hud-dest-btn--blocked{{/if}} {{#if custom}}ca-hud-dest-btn--custom{{/if}} {{#if autolocked}}ca-hud-dest-btn--autolocked{{/if}} {{#if isOrigin}}ca-hud-dest-btn--origin{{/if}}"
            data-node-id="{{id}}"
            data-dest-index="{{index}}"
            data-blocked="{{#if blocked}}true{{else}}false{{/if}}"
            data-autolocked="{{#if autolocked}}true{{else}}false{{/if}}"
            data-secret="{{#if secret}}true{{else}}false{{/if}}"
            data-custom="{{#if custom}}true{{else}}false{{/if}}"
            type="button">
      <span class="ca-hud-dest-text">
        <span class="ca-hud-dest-name">
          {{#if secret}}<i class="fa-solid fa-mask"></i>{{/if}}
          {{#if blocked}}<i class="fa-solid fa-ban"></i>{{/if}}
          {{#if custom}}<i class="fa-solid fa-key"></i>{{/if}}
          {{#if autolocked}}<i class="fa-solid fa-lock"></i>{{/if}}
          {{#if isOrigin}}<span class="ca-hud-origin-icon" title="You came from here">↩</span>{{/if}}{{label}}
        </span>
        {{#if sublabel}}<span class="ca-hud-dest-sub">{{sublabel}}</span>{{/if}}
      </span>
      {{#if previewSrc}}
      <span class="ca-hud-preview-eye" data-preview-src="{{previewSrc}}" data-is-video="{{isVideo}}">
        <i class="fa-solid fa-eye"></i>
      </span>
      {{/if}}
    </button>
    {{/each}}
  </div>
  {{/if}}

  <div class="ca-hud-orb-column">
    {{#if isGM}}
    <button
      class="ca-hud-manager-btn"
      data-action="open-manager"
      type="button"
      title="Open Scene Graph Manager"
    >
      <i class="fa-solid fa-sitemap"></i> Manager
    </button>

    <button
      class="ca-hud-mode-btn {{#if isGuideMode}}ca-hud-mode-btn--guide{{/if}}"
      data-action="toggle-gm-mode"
      type="button"
      title="{{#if isGuideMode}}Guide Mode: all players follow you. Click to switch to Solo.{{else}}Solo Mode: only you move. Click to switch to Guide.{{/if}}"
    >
      {{#if isGuideMode}}
        <i class="fa-solid fa-people-arrows"></i> Guide
      {{else}}
        <i class="fa-solid fa-user"></i> Solo
      {{/if}}
    </button>

    {{/if}}

    {{!-- Orb — shape (orb vs square) and content (image vs gradient) are independent --}}
    <div class="ca-hud-orb {{#if (eq orbType 'square')}}ca-hud-orb--square{{/if}}"
         title="Click to navigate · Hold to drag"
         style="--ca-orb-size: {{orbSizePx}}px; --ca-orb-inner: {{orbInnerPx}}px; --ca-orb-glow: {{orbGlowRgba}};">
      {{#if orbImage}}
        <img class="ca-hud-orb-img {{#if (eq orbType 'square')}}ca-hud-orb-img--square{{/if}}"
             src="{{orbImage}}" draggable="false" />
      {{else}}
        <div class="ca-hud-orb-inner {{#if (eq orbType 'square')}}ca-hud-orb-inner--square{{/if}}"
             style="background: {{orbGradient}};"></div>
      {{/if}}
    </div>

    {{#if isGM}}
    {{#if hasNodeSwitcher}}
    <button
      class="ca-hud-ns-toggle-btn"
      type="button"
      title="Switch node image or scene"
    >
      <i class="fa-solid fa-images"></i> Media
    </button>
    {{/if}}
    {{/if}}

    {{#if hasPeekPanel}}
    <button
      class="ca-hud-peek-toggle-btn"
      type="button"
      title="View linked rooms through cameras"
    >
      <i class="fa-solid fa-camera"></i> {{peekButtonLabel}}
    </button>
    {{/if}}
  </div>

  {{#if isGM}}
  {{#if hasNodeSwitcher}}
  <div class="ca-hud-node-switcher">
    {{#if nodeImages.length}}
    <div class="ca-hud-ns-section-title">Images</div>
    {{#each nodeImages}}
    <button
      class="ca-hud-ns-item {{#if isActive}}ca-hud-ns-item--active{{/if}}"
      data-action="switch-image"
      data-index="{{index}}"
      type="button"
    >
      <span class="ca-hud-dest-text">{{#if isActive}}<i class="fa-solid fa-star"></i>{{/if}} {{label}}</span>
      {{#if src}}
      <span class="ca-hud-preview-eye" data-preview-src="{{src}}" data-is-video="{{isVideo}}">
        <i class="fa-solid fa-eye"></i>
      </span>
      {{/if}}
    </button>
    {{/each}}
    {{/if}}
    {{#if nodeLinkedScenes.length}}
    <div class="ca-hud-ns-section-title">Linked Scenes</div>
    {{#each nodeLinkedScenes}}
    <button
      class="ca-hud-ns-item {{#if isActive}}ca-hud-ns-item--active{{/if}}"
      data-action="switch-linked-scene"
      data-index="{{index}}"
      data-scene-id="{{sceneId}}"
      type="button"
    >
      <span class="ca-hud-dest-text">{{#if isActive}}<i class="fa-solid fa-star"></i>{{/if}} <i class="fa-solid fa-map"></i> {{label}}</span>
      {{#if previewSrc}}
      <span class="ca-hud-preview-eye" data-preview-src="{{previewSrc}}" data-is-video="false">
        <i class="fa-solid fa-eye"></i>
      </span>
      {{/if}}
    </button>
    {{/each}}
    {{/if}}
  </div>
  {{/if}}
  {{/if}}

  {{#if hasPeekPanel}}
  <div class="ca-hud-peek-panel">
    <div class="ca-hud-ns-section-title"><i class="fa-solid fa-camera"></i> {{peekButtonLabel}}</div>
    <button
      class="ca-hud-ns-item"
      data-action="peek-restore"
      type="button"
      title="Restore the normal view of your current room"
    >
      <span class="ca-hud-dest-text"><i class="fa-solid fa-rotate-left"></i> Restore View</span>
    </button>
    {{#each peekableNodes}}
    <button
      class="ca-hud-ns-item {{#if isActive}}ca-hud-ns-item--active{{/if}}"
      data-action="peek-room"
      data-node-id="{{id}}"
      type="button"
    >
      <span class="ca-hud-dest-text"><i class="fa-solid fa-eye"></i> {{label}}</span>
      {{#if imageSrc}}
      <span class="ca-hud-preview-eye" data-preview-src="{{imageSrc}}" data-is-video="{{isVideo}}">
        <i class="fa-solid fa-eye"></i>
      </span>
      {{/if}}
    </button>
    {{/each}}
  </div>
  {{/if}}

  <div class="ca-hud-preview-popup"></div>

</div>
